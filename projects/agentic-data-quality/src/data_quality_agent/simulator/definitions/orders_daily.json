{
  "pipeline_id": "orders_daily",
  "name": "Daily orders quality pipeline",
  "dataset_file": "orders.json",
  "source_system": "orders-export-api",
  "source_dataset": "sales.orders",
  "expected_columns": ["order_id", "customer_id", "amount", "status"],
  "general_rules": {
    "minimum-volume": {
      "minimum_count": 4,
      "severity": "medium",
      "reason": "A normal day has at least 4 orders; fewer usually means a partial export."
    },
    "freshness": {
      "maximum_delay_minutes": 60,
      "reason": "Orders feed the morning report; the source promises data within 60 minutes."
    }
  },
  "rules": [
    {
      "rule_id": "required-customer",
      "name": "Customer is required",
      "kind": "not_null",
      "severity": "high",
      "field": "customer_id"
    },
    {
      "rule_id": "unique-order",
      "name": "Order identifier is unique",
      "kind": "unique",
      "severity": "critical",
      "field": "order_id"
    },
    {
      "rule_id": "valid-amount",
      "name": "Order amount is within range",
      "kind": "numeric_range",
      "severity": "high",
      "field": "amount",
      "minimum": 0,
      "maximum": 100000
    },
    {
      "rule_id": "valid-status",
      "name": "Order status is supported",
      "kind": "allowed_values",
      "severity": "medium",
      "field": "status",
      "allowed_values": ["created", "settled", "cancelled"]
    },
    {
      "rule_id": "known-customer",
      "name": "Customer reference exists",
      "kind": "referential_integrity",
      "severity": "high",
      "field": "customer_id",
      "reference_values": ["C-101", "C-102", "C-103", "C-104"]
    }
  ]
}
